---
const PLACEHOLDER_IMG =
    "https://storage.googleapis.com/nrm-web/sabrosita/resources/img/img_sabrosita.jpg";
// Fetch lanzamientos (category 293) similar to src/pages/lanzamientos/index.astro
const res = await fetch(
    "https://sabrositadigital.com.mx/wp-json/wp/v2/posts?_embed&per_page=10&categories=293&_fields=id,title,acf,slug,_links,_embedded",
);
let posts = await res.json();

posts = Array.isArray(posts) ? posts : [];

// Sort by position if available, similar to the main page logic
posts.sort(function (a: any, b: any) {
    return a.acf.posicion > b.acf.posicion
        ? 1
        : a.acf.posicion < b.acf.posicion
          ? -1
          : 0;
});
---

<div>
    <img
        loading="lazy"
        class="m-auto max-w-[200px]"
        src="https://storage.googleapis.com/nrm-web/sabrosita/titulo-lanzamientos.png"
        alt="Título Lanzamientos"
    />
</div>

<div class="slider-lanzamientos">
    <div class="carousel main-lanzamientos cards lanzamientos">
        {
            posts.map((post: any, index: number) => (
                <div
                    class="carousel-cell flex flex-col items-center text-white w-1/2 sm:w-1/3 lg:w-1/5 px-6 m-2"
                    data-pos={index + 1}
                >
                    <a class="w-full text-center" href={`/lanzamientos/`}>
                        <img
                            loading="lazy"
                            class="block aspect-square h-auto w-full shadow-[0_2px_12px_7px_rgba(0,0,0,0.4)] rounded-xl object-cover"
                            src={
                                post?._embedded?.["wp:featuredmedia"]?.[0]
                                    ?.media_details?.sizes?.["medium_large"]
                                    ?.source_url ||
                                post?._embedded?.["wp:featuredmedia"]?.[0]
                                    ?.media_details?.sizes?.["full"]
                                    ?.source_url ||
                                PLACEHOLDER_IMG
                            }
                            width="300"
                            height="300"
                            alt={
                                post?._embedded?.["wp:featuredmedia"]?.[0]
                                    ?.alt_text || "Imagen lanzamiento"
                            }
                        />
                    </a>

                    <div class="w-full grid grid-cols-12 items-center gap-2 mt-2">
                        <div class="col-span-2">
                            <span class="text-4xl rojo font-bold spartan whitespace-nowrap">
                                {index + 1}
                            </span>
                        </div>
                        <div class="col-span-9 flex flex-col">
                            <a href={`/lanzamientos/`}>
                                <p
                                    class="leading-none m-0 text-s text-zinc-400 font-normal"
                                    set:html={post.title.rendered}
                                />
                                <p
                                    class="font-bold leading-none m-0 text-xs text-white"
                                    set:html={post.acf.artista}
                                />
                            </a>
                        </div>
                        <div class="col-span-1 flex justify-end">
                            <div
                                class="like-lanzamientos cursor-pointer"
                                title="Votar"
                                data-song={post.title.rendered}
                                data-artist={post.acf.artista}
                            >
                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    width="28"
                                    height="28"
                                    stroke-width="1"
                                >
                                    <path d="M19.5 12.572l-7.5 7.428l-7.5 -7.428a5 5 0 1 1 7.5 -6.566a5 5 0 1 1 7.5 6.572" />
                                </svg>
                            </div>
                        </div>
                    </div>
                </div>
            ))
        }
    </div>
</div>

<style>
    .slider-lanzamientos {
        margin-top: 1rem;
        margin-bottom: 2rem;
    }

    .carousel {
        padding: 1%;
        border-radius: 0.25rem;
    }

    .carousel-cell {
        /* Using tailwind classes primary, but keeping some defaults */
        border-radius: 20px;
    }

    .carousel-cell img {
        border-radius: 12px;
    }
</style>
