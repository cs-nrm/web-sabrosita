---
import DoubleBox from '../components/DoubleBox.astro';
import BoxBanner from '../components/BoxBanner.astro';
import LeaderBoard from'../components/LeaderBoard.astro';
import SuperLeader from '../components/SuperLeader.astro';
import { Image } from 'astro:assets';


const res = await fetch("https://sabrositadigital.mx/wp-json/wp/v2/posts?_fields=date,title,slug,sticky,acf,yoast_head_json,content,excerpt,_links,_embedded&_embed&per_page=4&categories=143");
const posts = await res.json();
const filteredPosts = posts.filter((post:any) => !post.acf?.fijo);

---
<div class="max-w-[700px] m-auto text-center">
  <img class="max-w-[350px] m-auto text-center" src="https://storage.googleapis.com/nrm-web/sabrosita/titulo-tito.png" alt="Título Tito"/>
  <div class="primera-tito flex items-center">
    <article class="news-card">
      <a href={`/nota-sabrosa/${posts[0].slug}/`}>
        <div class="relative h-full">
          <img class="rounded-xl" src={posts[0]._embedded['wp:featuredmedia'][0].media_details.sizes['full'].source_url} alt="Imagen Las de Hoy"/>
          <div class="news-content absolute bottom-0 left-0 bg-black bg-opacity-60 text-white p-2 w-full rounded-b-xl ">
            <h6 class="leading-none" set:html={posts[0].title.rendered}></h6>
          </div>
        </div>
      </a>  
    </article>
    <img class="max-w-[170px]" src="https://storage.googleapis.com/nrm-web/sabrosita/logo-tito.png" alt="Logo Tito"/>
  </div>
  <div class="container cards mt-8">
    <div class="film">
      <div class="news-grid grid gap-4 grid-cols-1 md:grid-cols-2 lg:grid-cols-3 md:gap-16 xl:gap-16">
        {
          filteredPosts.slice(1, 4).map((post:any, idx:number) => (
            <div class={`cards-filtro-${idx}`}>
              <article class="news-card transition duration-[0.2s] hover:translate-y-[-4px]">
                <a href={`/nota-sabrosa/${post.slug}/`}>
                  <div><img class="rounded-xl" src={post._embedded['wp:featuredmedia'][0].media_details.sizes['full'].source_url} alt="Imagen Las de Hoy"/></div>
                  <div class="news-content p-6">
                    <h5 class="leading-none" set:html={post.title.rendered}></h5>
                    <!--div class="text-sm resumen" set:html={post.excerpt.rendered}></div>
                    <span class="roboto font-bold text-xs mt-4">por {post.yoast_head_json.author}</span-->
                  </div>
                </a>  
              </article>
            </div>
          ))
        }
        </div>

      </div>


      </div>
</div>

<div class="m-auto text-center">
    <a href="/nota-sabrosa">
        <button class="ver-mas group relative h-8 m-4 text-xl px-4 rounded-full spartan bold overflow-hidden bg-[#EA262A] border-4 border-[#EA262A] hover:border-[#FDCF27] font-bold">
            <span>Más noticias aquí</span>
        </button>
    </a>
</div>

