---
import { Image } from 'astro:assets';

const res = await fetch("https://contenido.sabrositadigital.mx/wp-json/wp/v2/posts?_embed&per_page=10&categories=292&order=asc&_fields=id,title,acf,content,slug,categories,_links,_embedded");
let posts = await res.json();

// Ordenar manualmente por acf.posicion (por si la API no lo hace)
posts = posts.sort((a, b) => (a.acf?.posicion ?? 0) - (b.acf?.posicion ?? 0));

---
    <div class="block md:flex gap-8 md:gap-16 items-center rounded-xl">
		<div class="news-content w-[100%] md:w-[50%]">
			<img src="https://storage.googleapis.com/nrm-web/sabrosita/resources/img/HOTPARADE-min.jpg" alt="Imagen Hot Parade" class="rounded-xl object-cover" />
        </div>
        <div class="w-[100%] md:w-[50%] relative">
			<img class="rounded-xl object-cover" src={posts[0]._embedded['wp:featuredmedia'][0].media_details.sizes['full'].source_url} alt="Imagen Hot Parade"/>
						
			<a class="absolute text-center text-white bottom-0 w-full" href={`/topten/${posts[0].slug}/`}>
				<div class="rojo cursor-pointer text-white" data-podcast-status="ready"> 
					<svg xmlns="http://www.w3.org/2000/svg" class="icon icon-tabler bg-[#e2241a] hover:bg-black rounded-[50%] p-[15px] m-auto icon-tabler-player-play" width="100" height="100" viewBox="0 0 24 24" stroke-width="2" stroke="#fff" fill="#fff" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M7 4v16l13 -8z" /></svg>
					<span class="text-lg text-base lg:text-lg text-white roboto">Ver el Video</span>
				</div> 
				<div class="flex items-center justify-between px-8 spartan">
					<span class="text-7xl sm:text-9xl md:text-6xl lg:text-8xl xl:text-9xl font-bold rojo ">1</span>
					<div class="">
						<p class="text-3xl text-xl lg:text-3xl font-bold text-right m-0 uppercase" set:html={posts[0].title.rendered}></p>
						<p class="text-lg text-right m-0" set:html={posts[0].acf.artista}></p>
					</div>
				</div>
			</a>
		</div>
    </div>

<!--div class="main-topten" data-flickity='{ "lazyLoad": 1, "wrapAround": true, "cellAlign": "center", "pageDots": false, "autoPlay": true}'-->
<div class="topten main-topten mt-8">
	{
	posts.map((post:any, index)=> (
		<a class=" flex flex-col items-center text-white w-1/2 sm:w-1/3 lg:w-1/5 px-8 m-4" href={`/topten/${post.slug}/`}>
			<div class="w-12/12 text-center">
				<Image class="block h-auto w-full shadow-[0_2px_12px_7px_rgba(0,0,0,0.4)] rounded-xl object-fill" src={post._embedded['wp:featuredmedia'][0].media_details.sizes['thumbnail'].source_url} width="300" height="150" alt="Imagen Ilustrativa Hot Parade"  />
			</div>
			<div class="flex flex-wrap items-center">
				<div class="w-4/12">
					<span class="text-4xl rojo font-bold spartan" set:html={index+1}></span>
				</div>
				<div class="w-8/12 flex flex-col flex-nowrap">
					<p class="font-bold leading-none m-0 text-xs" set:html={post.acf.artista}></p>
					<p class="leading-none m-0 text-xs text-zinc-400 font-normal" set:html={post.title.rendered}></p>
				</div>
			</div>
		</a>
	))    
	}
</div>




<style>
.carousel-cell {
  width: 150px;
  height: 200px;
  margin-right: 80px;
  border-radius: 20px;
}

.carousel-cell img{
	border-radius: 50%;
	box-shadow: 0 2px 12px 7px rgba(0,0,0,0.4);
	margin-top: 20px;
}

.carousel-cell.is-selected {
  /*background: #ED2;*/
}

.news-content{
	position: relative ;
}
/*.news-content::after{
	content: '';
	width: calc(100% - 40px);
	height: 100%;
	background: #ededed;
	background: linear-gradient(0deg,rgba(237, 237, 237, 1) 0%, rgba(237, 237, 237, 0) 100%);
	display: inline-block;
	position: absolute;
	top: 0;
	border-radius: 0.75rem;
}*/
.getcancion, .letra-de-cancion {
  line-height: 1.6;
 	display: -webkit-box;
  -webkit-line-clamp: 9;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

@media (max-width: 1280px){
	.getcancion, .letra-de-cancion {
		-webkit-line-clamp: 7;
	}
}
@media (max-width: 450px){
	svg{
		width:75px !important;
		height:75px !important;
	}
}

@media (max-width: 1024px){
	svg{
		width:80px;
		height:80px;
	}
	.news-content .letra p{
		font-size: 12px;
		line-height: 1;
	}
	.getcancion, .letra-de-cancion {
		-webkit-line-clamp: 6;
	}
}


</style>