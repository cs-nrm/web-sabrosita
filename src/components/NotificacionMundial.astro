  rel="stylesheet"
  type="text/css"
  href="https://storage.googleapis.com/nrm-web/nrm/lib/notificacion/ns-style-other.css"
/>

<script is:inline>
  const aniom = 2026;
  const mesm = 6; // Agosto (0=enero, 7=agosto, 8=septiembre, 9=octubre, 10=Noviembre, 11=Diciembre)
  const diam = 1;
  const diafinm = 9;
  const horaIniciom = { h: 10, m: 20 }; //
  const horaFinm = { h: 15, m: 40 }; //

  function estaEnRangom() {
    const ahoram = new Date();
    const iniciom = new Date(aniom, mesm, diam, horaIniciom.h, horaIniciom.m, 0, 0);
    const finm = new Date(aniom, mesm, diafinm, horaFinm.h, horaFinm.m, 0, 0);
    return ahoram >= iniciom && ahoram <= finm;
  }

  function mostrarNotificacionm() {
    var notificationm = new NotificationFxm({
      wrapper: document.body,
      message:
        '<div class="fondo-live"><a target="_" href="https://fiestafutbol.com.mx/"><h3>CLICK AQUÍ</h3><svg xmlns="http://www.w3.org/2000/svg" class="icon icon-tabler icon-tabler-hand-click" width="44" height="44" viewBox="0 0 24 24" stroke-width="1.5" stroke="#000" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M8 13v-8.5a1.5 1.5 0 0 1 3 0v7.5" /><path d="M11 11.5v-2a1.5 1.5 0 0 1 3 0v2.5" /><path d="M14 10.5a1.5 1.5 0 0 1 3 0v1.5" /><path d="M17 11.5a1.5 1.5 0 0 1 3 0v4.5a6 6 0 0 1 -6 6h-2h.208a6 6 0 0 1 -5.012 -2.7l-.196 -.3c-.312 -.479 -1.407 -2.388 -3.286 -5.728a1.5 1.5 0 0 1 .536 -2.022a1.867 1.867 0 0 1 2.28 .28l1.47 1.47" /><path d="M5 3l-1 -1" /><path d="M4 7h-1" /><path d="M14 3l1 -1" />  <path d="M15 6h1" /></svg></a></div>',
      layout: "attached",
      effect: "bouncyflip",
      ttl: 90000,
      type: "notice",
      onClose: function () {
        return false;
      },
      onOpen: function () {
        return false;
      },
    });
    notificationm.show();
    // Oculta la notificación si se sale del rango horario
    const ahoram = new Date();
    const finm = new Date();
    finm.setHours(horaFinm.h, horaFinm.m, 0, 0);
    const msRestantes = finm - ahoram;
    if (msRestantes > 0) {
      setTimeout(() => notificationm.dismiss(), msRestantes);
    }
  }

  // Ejecuta al cargar y revisa cada minuto si debe mostrar/ocultar
  function revisarNotificacionm() {
    if (estaEnRangom()) {
      mostrarNotificacionm();
    }
  }
  setTimeout(revisarNotificacionm, 100); // Primer intento rápido
  //setInterval(revisarNotificacionm, 60000); // Revisa cada minuto
</script>

<script
  is:inline
  src="https://storage.googleapis.com/nrm-web/nrm/lib/notificacion/classie.js"
></script>
