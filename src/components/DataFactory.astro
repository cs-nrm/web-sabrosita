---
const mainUrl = 'https://enfoquenoticias.com.mx/feeds/main.json';

// 1. Leer main.json
let mainData = await fetch(mainUrl).then(res => res.json());

// 2. Filtrar solo los canales .preview de Liga MX
let previewFeeds = mainData.canales
  .filter(canal => canal.canal.startsWith('deportes.futbol.mexico.ficha.') && canal.canal.endsWith('.preview'))
  .map(canal => canal.json);

// 3. Cargar todos los previews (paralelo)
let partidos = await Promise.all(
  previewFeeds.map(async url => {
    try {
      let data = await fetch(url).then(res => res.json());
      // Estructura: { Match: {...} }
      return data.Match;
    } catch (e) {
      return null;
    }
  })
);
// Filtrar nulos (por si alguno falla)
partidos = partidos.filter(Boolean);

// Ordenar por fecha
partidos.sort((a, b) => a['@date'].localeCompare(b['@date']));

// Utilidad para formatear la fecha a dd/mm/yyyy y hora
function formatFecha(fechaStr) {
  // fechaStr: "20250809"
  return fechaStr ? `${fechaStr.slice(6,8)}/${fechaStr.slice(4,6)}/${fechaStr.slice(0,4)}` : '';
}
function formatHora(horaStr) {
  // horaStr: "00:00:00"
  return horaStr ? horaStr.slice(0,5) : '';
}

// URL de escudo
const getEscudoUrl = id =>
  `https://storage.googleapis.com/nrm-web/nrm/images/datafactory/escudos/mx/escudos/${id}.gif`;
---

<html lang="es">
  <head>
    
  </head>
  <body class="bg-[#41154d] py-8">
    <div class="flex flex-col items-center justify-center">
      <h2 class="text-yellow-400 text-xl font-bold mb-4">
        Próxima jornada Liga MX
      </h2>
      <div 
        class="carousel"
        data-flickity='{ "cellAlign": "left", "contain": true, "prevNextButtons": true, "pageDots": false }'
        style="width: 100%; max-width: 100%;"
      >
        {partidos.length === 0 ? (
          <div class="bg-white text-center text-lg text-[#41154d] p-10 rounded-lg">
            No hay partidos programados para la próxima jornada.
          </div>
        ) : (
          partidos.map(partido => (
            <div class="bg-[#fcd586] rounded-2xl shadow-lg px-6 py-4 m-3 w-[300px] flex flex-col items-center" style="min-width: 270px; max-width: 300px;">
              <div class="w-full mb-2">
                <div class="bg-[#ffb534] px-4 py-2 rounded-t-2xl text-sm font-bold text-[#41154d] text-center">
                  {partido['@competition']}<br />
                  {formatFecha(partido['@date'])} {formatHora(partido['@scheduledStart'])} hrs.
                </div>
              </div>
              <div class="flex items-center justify-center gap-4 mt-2">
                <img src={getEscudoUrl(partido['@homeTeamId'])} alt={partido['@homeTeamName']} class="h-12" />
                <span class="text-2xl font-bold text-[#41154d]">VS</span>
                <img src={getEscudoUrl(partido['@awayTeamId'])} alt={partido['@awayTeamName']} class="h-12" />
              </div>
              <div class="flex items-center justify-between gap-4 mt-2 w-full px-4">
                <span class="font-bold text-lg text-[#41154d]">{partido['@homeTeamName'].toUpperCase()}</span>
                <span class="font-bold text-lg text-[#41154d]">{partido['@awayTeamName'].toUpperCase()}</span>
              </div>
            </div>
          ))
        )}
      </div>
    </div>
    
  </body>
</html>