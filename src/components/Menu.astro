.dd-menu {
	display:block;
  position: relative;
  overflow: visible;
}

nav ul ul {
	display: none;
	position: absolute; 
  background: white;
  top: 20px;
  left: 0;
  overflow: visible;
  padding-top: 5px;
}
	

nav ul li:hover > ul {
	display:inherit;
}
	
.dd-menu li a{
  font-size: 14px;

}
nav ul ul li {
	width:160px;
	float:none;
	display:list-item;
	position: relative;
  margin-bottom: 5px;
  padding: 3px 6px;
  line-height: 13px;
}


nav ul ul ul li {
	position: relative;
	top:-60px; 
	left:170px;
}

	

li > a:after, .dd-menu:after { content:  ' ▼'; font-size: 10px;}
li > a:only-child:after, li > .dd-menu:only-child:after { content: ''; }


