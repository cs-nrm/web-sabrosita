---
const currentPath = Astro.url.pathname;
---

  <!-- Navigation -->
  <nav class="nav-menu">
    <ul class="menu-desktop">
      <li class={`menu-section${currentPath.startsWith('/nota-sabrosa') ? ' active' : ''}`}><a href="/nota-sabrosa">Nota Sabrosa</a></li>
      <li class={`menu-section${currentPath.startsWith('/promociones') ? ' active' : ''}`}><a href="/promociones">Promociones</a></li>
      <li class={`menu-section${currentPath.startsWith('/hot-parade') ? ' active' : ''}`}><a href="/hot-parade">Hot Parade</a></li>
      <li class={`menu-section${currentPath.startsWith('/entrevistas') ? ' active' : ''}`}><a href="/entrevistas">Entrevistas</a></li>
      <li class="dd-menu">Podcast
        <ul>
          <li class={`menu-section${currentPath.startsWith('/audio-podcast') ? ' active' : ''}`}><a href="/audio-podcast">Audio Podcast</a></li>
          <li class={`menu-section${currentPath.startsWith('/video-podcast') ? ' active' : ''}`}><a href="/video-podcast">Video Podcast</a></li>
        </ul>        
      </li>
      <li class={`menu-section${currentPath.startsWith('/son-sonidero') ? ' active' : ''}`}><a href="/son-sonidero">Son Sonidero</a></li>
    </ul>
    <ul class="menu-mobile !hidden">
      <li class={`menu-section${currentPath.startsWith('/nota-sabrosa') ? ' active' : ''}`}><a href="/nota-sabrosa">Nota Sabrosa</a></li>
      <li class={`menu-section${currentPath.startsWith('/promociones') ? ' active' : ''}`}><a href="/promociones">Promociones</a></li>
      <li class={`menu-section${currentPath.startsWith('/hot-parade') ? ' active' : ''}`}><a href="/hot-parade">Hot Parade</a></li>
      <li class={`menu-section${currentPath.startsWith('/entrevistas') ? ' active' : ''}`}><a href="/entrevistas">Entrevistas</a></li>
      <li class={`menu-section${currentPath.startsWith('/audio-podcast') ? ' active' : ''}`}><a href="/audio-podcast">Audio Podcast</a></li>
      <li class={`menu-section${currentPath.startsWith('/video-podcast') ? ' active' : ''}`}><a href="/video-podcast">Video Podcast</a></li>
    </ul>
  </nav>

<style>
/* Navigation styles */

.nav-menu .active a:hover{
  color:white !important;
}
.nav-menu {
  /*background: black;*/
  padding: 0.5rem;
  font-family: 'Roboto';
  z-index: 999;
}

.nav-menu ul {
  list-style: none;
  display: flex;
  flex-wrap: wrap;
  column-gap: 1.3rem;
  max-width: 72rem;
  margin: 0 auto;
  justify-content: center;
  line-height: 1.3;
}

.nav-menu a, .nav-menu li {
  color: white;
  text-decoration: none;
  font-size: 0.8rem;
  transition: color 0.2s;
}

.nav-menu a:hover, .nav-menu li:hover {
  color: #717171;
}

.nav-menu a.active, .nav-menu li.active {
  color: #caccce;
}

@media (max-width: 1236px){
  .nav-menu ul{
    flex-wrap: nowrap;
    white-space: nowrap;
    overflow-x: scroll;
    -ms-overflow-style: none;  
    scrollbar-width: none;  
    justify-content: left;
  }
  .menu-mobile { 
      display: flex !important;  
  }
  .menu-desktop{
    display: none !important;
  }
  .nav-menu:after { content:  'ᐅ'; font-size: 18px; position: absolute; top: 30%; right: 4px;}
}

