---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CardNews from '../layouts/CardsHomeNews.astro';
import CardEntrevistas from '../layouts/CardsHomeEntrevistas.astro';
import Separator from '../components/Separator.astro'; 
import HomeHeader from '../layouts/HomeHeader.astro';
import DoubleBox from '../components/DoubleBox.astro';
import BoxBanner from '../components/BoxBanner.astro';
import LeaderBoard from'../components/LeaderBoard.astro';
import Modal from'../components/Modal.astro';
import LeaderBoard2 from'../components/LeaderBoard2.astro';
import SuperLeader from '../components/SuperLeader.astro';
import BillBoard from '../components/BillBoard.astro';
import BillBoard2 from '../components/BillBoard2.astro';

import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import BarNrm from '../components/BarNrm.astro';
import NotaPrincipal from '../layouts/CardsHomePrincipal.astro';
import Viajes from '../layouts/CardsHomeViajes.astro';
import CardsHomeTito from '../layouts/CardsHomeTito.astro';
import Podcast from '../layouts/CardsHomePodcast.astro';
import NewsLetter from '../layouts/NewsLetter.astro';
import Promociones from '../layouts/SliderPromociones.astro';
import SliderHotParade from '../layouts/SliderHotParade.astro';
import SliderPodcast from '../layouts/SliderPodcast.astro';
import DataFactory from '../components/DataFactory.astro';

---

<!doctype html>
<html lang="es">
    <head>
        <BaseHead title={SITE_TITLE} seccion="Home" description={SITE_DESCRIPTION} />       
    </head>
    <body>
        <Header title={SITE_TITLE} />
        <BarNrm />
        <main id="home">
                <section>                   
                    <div class="container-home p-4 mx-auto">                        
                        <NotaPrincipal />
                        <CardNews />
                    </div>
                </section>
                <LeaderBoard />
                <section class="bg-[url(https://storage.googleapis.com/nrm-web/sabrosita/FONDO_TITO.png)] bg-cover bg-no-repeat bg-center">
                    <div class="container-home p-4 mx-auto">          
                        <CardsHomeTito />
                    </div>
                </section>
                    <div class="container-home p-4 mx-auto">
                        <div class="flex flex-col md:flex-row justify-center items-center">
                            <div class="px-2 w-[80%] datafactory" >  
                                <img class="max-w-[200px] m-auto" src="https://storage.googleapis.com/nrm-web/sabrosita/titulos/DEPORTES.png" alt="Título Deportes"  >
                                <DataFactory /> 
                            </div>
                            <div class="flex items-end md:pt-14 px-2 w-[350px] lotenal m-auto"><a href="https://www.loterianacional.gob.mx/Mascarillas/ListasPremios" target="_blank"> <img class="w-[300px] rounded-xl" src="https://storage.googleapis.com/nrm-web/sabrosita/IMG_LOTERIA-min.jpg" /></a> </div>
                        </div>
                    </div>                                
                <BillBoard />
                <section>
                    <div class="container-home p-4 mx-auto">                        
                        <SliderHotParade/>
                    </div>
                </section>
                <BillBoard2 />
                <section>
                    
                    <div class="container-home p-4 mx-auto">                        
                    <SliderPodcast />    
                    </div>
                </section>
                <section>
                    <div class="container-home p-4 mx-auto">
                        <div class="grid grid-cols-1 lg:grid-cols-3 gap-4 mt-16">
                            <div class="lg:col-span-2">
                                <CardEntrevistas />
                            </div>
                            <div class="">
                                <BoxBanner />
                            </div>
                        </div>                
                    </div>
                </section>
                <LeaderBoard2 />
                <section class="">
                            
                    <div class="container-home p-4 mx-auto">
                        <Promociones />    
                    </div>
                </section>
        </main> 
        <!--Modal/-->
        <Footer />
    </body>
</html>
